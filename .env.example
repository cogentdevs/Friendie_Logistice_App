API_BASE_URL=
# Example: http://YOUR_COMPUTER_LAN_IP:8000/api/v1 (Android debug only)
NAVIGATION_PREVIEW=false
FIREBASE_ENABLED=false
# Your Laravel Places proxy, never a Google server key.
PLACES_PROXY_URL=


# Enable only after confirming login/profile routes and DTOs with the Laravel backend.
AUTH_API_VERIFIED=false

# Confirm listing filters, radius contract and paginated response before enabling.
LISTINGS_API_VERIFIED=false

# Debug builds: Sign In opens the UI without validation or a real session.
# Set false to test actual authentication. Ignored in release builds.
UI_PREVIEW_ENABLED=true

# Enable only after confirming the geocoding proxy contract.
PLACES_API_VERIFIED=false

# Enable only after confirming GET /listings/:id and its detail DTO.
LISTING_DETAILS_API_VERIFIED=false

# Verify read/send DTOs and server-enforced idempotency before enabling chat.
CHAT_API_VERIFIED=false
CHAT_IDEMPOTENCY_VERIFIED=false

# Verify authenticated, server-scoped GET /user/listings before enabling.
MY_LISTINGS_API_VERIFIED=false

# Verify extended authenticated GET /user statistics DTO before enabling.
PROFILE_API_VERIFIED=false

# Real legal document URLs; leave empty until configured.
TERMS_URL=
PRIVACY_URL=
