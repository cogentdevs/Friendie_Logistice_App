{
  "extends": "@react-native/typescript-config",
  "include": [
    "App.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx",
    "nativewind-env.d.ts"
  ],
  "exclude": ["node_modules", "android", "ios", ".validation"],
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true
  }
}
